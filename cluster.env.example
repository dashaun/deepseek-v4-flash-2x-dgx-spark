# Cluster settings for start.sh / stop.sh / status.sh / loadtest.py (sourced as bash).
# Copy to cluster.env (git-ignored) and edit, or point CLUSTER_ENV at another file.
# HEAD_HOST, WORKER_HOST, HEAD_IP and WORKER_IP can also be overridden from the environment:
#   HEAD_HOST=spark-01 WORKER_HOST=spark-02 ./status.sh

# SSH names of the two Sparks, as reachable from this machine (Tailscale, DNS or ~/.ssh/config).
HEAD_HOST=spark-head
WORKER_HOST=spark-worker
# QSFP addresses of ETH_IF on each node, used for Ray and NCCL bootstrap.
HEAD_IP=192.168.200.1
WORKER_IP=192.168.200.2

# Interface and RoCE device names are the same on every DGX Spark (check with `ibdev2netdev`).
# Control-plane interface carrying HEAD_IP/WORKER_IP (Ray, Gloo, NCCL bootstrap).
ETH_IF=enp1s0f0np0
# RoCE devices NCCL uses for tensor traffic. Each QSFP port appears as two devices, one per
# GB10 PCIe connection; listing all four uses both cables. Trim to isolate a link.
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
IB_GID_INDEX=3 # RoCE v2 / IPv4 (check /sys/class/infiniband/<dev>/ports/1/gid_attrs/types/3)

# Pinned by digest so both nodes run identical bits. Change deliberately.
IMAGE=eugr/spark-vllm-b12x@sha256:8e7e062186f841453ef0ec6f713043c5b65447decc3835206685128c18e42262
CONTAINER_NAME=vllm_node

# Selects models/$MODEL.env
MODEL=deepseek-v4-flash-0731

API_PORT=8000
RAY_PORT=29501
NCCL_TEST_PORT=29600
RAY_OBJECT_STORE_BYTES=1073741824

# Bind-mount vLLM/FlashInfer/Triton compile caches from the hosts
# (~/.cache/vllm, ~/.cache/flashinfer, ~/.triton) so restarts skip recompiling.
MOUNT_COMPILE_CACHES=true

# Seconds start.sh waits for /health after launching vLLM.
WAIT_TIMEOUT=2400
# Preflight warns when a host has less available memory than this (GiB).
MIN_FREE_GB=100

# Extra env for both containers and extra flags for vllm serve.
EXTRA_CONTAINER_ENV=(NCCL_DEBUG=WARN)
EXTRA_SERVE_ARGS=()
