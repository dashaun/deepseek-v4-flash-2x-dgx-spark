# DeepSeek-V4-Flash-0731 on 2x DGX Spark (TP=2 over Ray).
# Adapted from eugr/spark-vllm-docker recipes/deepseek-v4-flash-0731.yaml (commit 3e1578b, 2026-09-12).
MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
# Preflight checks that the cached refs/main points at this snapshot on both nodes.
MODEL_REVISION=7872f01b1d1fe23eabc4c98b48bffcef5a386062
TP_SIZE=2

# Directories under ./mods applied inside both containers before serving.
MODS=(instanttensor-hybrid-draft-loader)

# Set on the containers rather than the serve process so Ray workers on the other
# node inherit them. Changing these requires ./stop.sh && ./start.sh.
MODEL_CONTAINER_ENV=(
  CUTE_DSL_ARCH=sm_121a
  VLLM_USE_AOT_COMPILE=1
  VLLM_USE_BREAKABLE_CUDAGRAPH=0
  VLLM_USE_MEGA_AOT_ARTIFACT=1
  VLLM_MEMORY_PROFILE_INCLUDE_ATTN=1
  VLLM_USE_FLASHINFER_SAMPLER=1
  VLLM_USE_B12X_WO_PROJECTION=1
  VLLM_USE_B12X_MHC=1
  VLLM_USE_B12X_FP8_GEMM=1
  VLLM_USE_B12X_MOE=1
  VLLM_USE_B12X_SPARSE_INDEXER=1
  VLLM_USE_V2_MODEL_RUNNER=1
  VLLM_MOE_SKIP_PADDING=0
  B12X_MLA_SM120_UNIFIED=1
  B12X_MOE_FORCE_A8=1
  # Weights are already cached on both nodes; never reach out to the Hub at startup.
  HF_HUB_OFFLINE=1
)

# Flags after `vllm serve $MODEL_ID`. start.sh adds --host/--port,
# --tensor-parallel-size and --distributed-executor-backend ray.
SERVE_ARGS=(
  --trust-remote-code
  --kv-cache-dtype fp8
  --block-size 256
  # Pinned instead of `auto`: when auto-fit shrinks the context below the native 1,048,576
  # (it did on a run with ~3 GiB less free memory), CUDA graph capture trips
  # `assert active_topk_width >= ...` in vllm/models/deepseek_v4/sparse_mla.py. Keep it small enough
  # for the KV cache; the source suggests a multiple of 16384 (128 compress ratio x 128 alignment),
  # which is inferred, not tested.
  --max-model-len 1048576
  --max-num-seqs 8
  --max-num-batched-tokens 8192
  # KV cache size is fixed so every start behaves the same. With gpu-memory-utilization 0.85 the
  # profiled KV budget varied 9.66–14.35 GiB between identical starts, and 0.87 gave 16.6 GiB and
  # froze BOTH Sparks (GPU and host share memory on GB10). A 1M-token request needs 10.06 GiB;
  # 11G adds ~9% and stays below the 12.84/14.35 GiB budgets that ran stably.
  # vLLM ignores --gpu-memory-utilization when --kv-cache-memory-bytes is set. 0.85 is kept as the
  # fallback if the line above is removed; don't raise it (0.87 froze both nodes).
  --kv-cache-memory-bytes 11G
  --gpu-memory-utilization 0.85
  --enable-prefix-caching
  --tokenizer-mode deepseek_v4
  --tool-call-parser deepseek_v4
  --enable-auto-tool-choice
  --reasoning-parser deepseek_v4
  --reasoning-config '{"reasoning_parser":"deepseek_v4","reasoning_start_str":"","reasoning_end_str":""}'
  --default-chat-template-kwargs.thinking=true
  --default-chat-template-kwargs.reasoning_effort=high
  --load-format instanttensor
  --moe-backend b12x
  --linear-backend b12x
  --attention-backend B12X
  --max-cudagraph-capture-size 48
  --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}'
  --speculative-config '{"method":"dspark","num_speculative_tokens":5,"draft_sample_method":"probabilistic","attention_backend":"B12X"}'
)
